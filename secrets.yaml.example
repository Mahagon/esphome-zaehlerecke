# Diese Datei nach secrets.yaml kopieren und die Werte ersetzen.
# secrets.yaml steht in .gitignore und landet nicht im Repo.
wifi_ssid: "DEIN-WLAN"
wifi_password: "DEIN-WLAN-PASSWORT"

# Passwort für den Hotspot, den das ESP aufmacht, wenn es das WLAN nicht findet
fallback_password: "mindestens-8-zeichen"

# Schlüssel für die verschlüsselte Verbindung zu Home Assistant (32 Byte, Base64).
# Erzeugen mit: openssl rand -base64 32
api_key_zaehlerecke: "HIER-DEN-KEY-EINTRAGEN"

# Passwort für Updates über WLAN, frei wählbar
ota_password: "HIER-EIN-PASSWORT"
