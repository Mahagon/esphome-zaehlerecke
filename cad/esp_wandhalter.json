    "plate_w / 2 + screw_dx",
    "plate_h / 2",
    "-1 mm"
   ],
   "axis": "Z",
   "diameter": "screw_d",
   "operation": "cut",
   "targets": [
    "Wandhalter"
   ]
  }
 },
 {
