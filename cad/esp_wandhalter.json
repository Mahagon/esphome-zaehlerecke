   "top_diameter": "head_d + 1 mm",
   "height": "(head_d - screw_d) / 2 + 1 mm",
   "base": [
    "plate_w / 2 - screw_dx",
    "plate_h / 2",
    "plate_t - (head_d - screw_d) / 2 - 0.5 mm"
   ],
   "axis": "Z",
   "operation": "cut",
   "targets": [
    "Wandhalter"
   ]
  }
 },
 {
  "command": "solid.cylinder",
  "params": {
   "height": "plate_t + 2 mm",
