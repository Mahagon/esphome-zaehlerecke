 {
  "command": "solid.box",
  "params": {
   "length": "plate_w",
   "width": "plate_h",
   "height": "plate_t",
   "corner": [
    0,
    0,
    0
   ],
   "body_name": "Wandhalter"
  }
 },
 {
  "command": "sketch.create",
  "params": {
   "plane": "XZ"
  }
 },
 {
  "command": "sketch.line",
  "params": {
   "points": [
    [
     "plate_w / 2 - (dt_n + 2 * 0 mm) / 2",
     "-(plate_t - 0.01 mm)"
    ],
    [
     "plate_w / 2 + (dt_n + 2 * 0 mm) / 2",
     "-(plate_t - 0.01 mm)"
    ],
    [
     "plate_w / 2 + (dt_w + 2 * 0 mm) / 2",
     "-(plate_t + dt_h + 0 mm)"
    ],
    [
     "plate_w / 2 - (dt_w + 2 * 0 mm) / 2",
     "-(plate_t + dt_h + 0 mm)"
    ]
   ],
   "closed": true
  }
 },
 {
  "command": "sketch.finish",
  "params": {}
 },
 {
  "command": "solid.extrude",
